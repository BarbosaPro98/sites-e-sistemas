# Senha única da equipe para acessar /admin/crm (obrigatória)
ADMIN_PASSWORD=
# Opcional: segredo para assinar a sessão (se vazio, usa a própria senha)
ADMIN_SESSION_SECRET=

# Banco de dados (libSQL/SQLite).
# Local: deixe vazio para usar ./data/leads.db
# Produção (Vercel etc.): crie um banco no Turso e informe a URL libsql:// e o token
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# PENDENTE: WhatsApp da clínica com DDI + DDD, só números (ex.: 5511999999999).
# Enquanto vazio, os botões de agendamento levam ao Instagram.
NEXT_PUBLIC_CLINIC_WHATSAPP=
# PENDENTE: texto do benefício exclusivo para participantes da Corrida AMB
NEXT_PUBLIC_EVENT_BENEFIT=
